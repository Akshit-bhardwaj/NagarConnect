# ==============================================================================
# NagarConnect CivicTech Platform - Master Template Configuration (.env.example)
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL 17 Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nagarconnect
DB_USER=postgres
DB_PASSWORD=postgres

# Asynchronous connection string for FastAPI (asyncpg)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nagarconnect

# Synchronous connection string for Alembic DB migrations (psycopg2)
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<dbname>
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/nagarconnect

# ------------------------------------------------------------------------------
# Service Ports and Base URLs
# ------------------------------------------------------------------------------
# nagam-backend (FastAPI REST API Engine)
BACKEND_PORT=8000
API_URL=http://localhost:8000/api/v1
DOCS_URL=http://localhost:8000/docs

# nagam-website (Public Landing & Services Discovery Portal)
WEBSITE_PORT=3000
WEBSITE_URL=http://localhost:3000

# nagam-client (Citizen Self-Service & Grievance Tracking Portal)
CLIENT_PORT=3001
CLIENT_URL=http://localhost:3001

# nagam-admin (Municipal Corporation Staff & Operations Dashboard)
ADMIN_PORT=3002
ADMIN_URL=http://localhost:3002

# nagam-super-admin (Multi-Tenant Platform Administration Console)
SUPER_ADMIN_PORT=3003
SUPER_ADMIN_URL=http://localhost:3003

# ------------------------------------------------------------------------------
# Pre-seeded Accounts for Local Verification & Testing
# ------------------------------------------------------------------------------
# Platform Super Admin:  superadmin@nagarconnect.gov.in / NagarConnect@2026
# Municipal Admin (LMC): admin@lmc.gov.in               / NagarConnect@2026
# Sanitation Officer:    officer.sanitation@lmc.gov.in  / NagarConnect@2026
# Ward Officer:          ward.hazratganj@lmc.gov.in     / NagarConnect@2026
# Citizen User:          citizen@example.com            / Citizen@2026
