APP_NAME=NagarConnect
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=change_this_to_a_secure_random_key_in_production_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Asynchronous DB URL for FastAPI (PostgreSQL 17 via asyncpg)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nagarconnect

# Synchronous DB URL for Alembic migrations (PostgreSQL 17 via psycopg2)
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<dbname>
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/nagarconnect

# CORS Origins (Website 3000, Citizen 3001, Admin 3002, Super Admin 3003)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:3003","http://127.0.0.1:3000","http://127.0.0.1:3001","http://127.0.0.1:3002","http://127.0.0.1:3003"]

# Local File Storage Adapter
STORAGE_DIR=uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=["jpg","jpeg","png","pdf","webp"]

LOG_LEVEL=INFO
